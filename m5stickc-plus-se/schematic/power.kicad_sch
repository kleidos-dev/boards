	(text "The AXP192 takes VBUS_USB (VBUS), VBUS_VIN (ACIN), the cell (BAT) and the backup cell (BACKUP), and gives IPSOUT, DCDC1 (VESP_3V3), LDO1 to LDO3 (RTC_VDD, LCD_BL_VCC, LCD_LOGIC_VCC) and GPIO0 (MIC_VCC). The print states no voltage for VBUS_VIN, RTC_VDD, LCD_BL_VCC, LCD_LOGIC_VCC or MIC_VCC; the docs page and the AXP192 datasheet give all but RTC_VDD's (K5 to K8)."
		(exclude_from_sim no)
		(at 15.24 135.48 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "4a7e9253-b760-5605-8687-12b35cfa1ab9")
	)
